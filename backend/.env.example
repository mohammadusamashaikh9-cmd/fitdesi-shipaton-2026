# Local listener. Keep loopback unless deploying behind a reviewed TLS proxy.
HOST=127.0.0.1
PORT=3000

# Safe provider defaults. Remote execution remains disabled even if a key exists.
AI_PROVIDER=mock
REMOTE_AI_ENABLED=false
# Server-only key material for opaque Stage 12E account and request identities.
# Keep empty until deployment configuration is separately reviewed.
REMOTE_ADMISSION_HMAC_SECRET=
# Server-owned durable reservation recovery lease; not a commercial quota.
REMOTE_ADMISSION_LEASE_SECONDS=60
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
# Evaluation-only server credential. A key does not enable evaluation or production routing.
OPENROUTER_API_KEY=
# Controlled synthetic OpenRouter evaluation only; these limits do not enable
# OpenRouter or approve a production model. Production remote AI is separately gated.
OPENROUTER_EVALUATION_TIMEOUT_MS=30000
OPENROUTER_EVALUATION_MAX_OUTPUT_TOKENS=4096
# Controlled synthetic Fireworks evaluation only; independent of production budgets.
FIREWORKS_EVALUATION_TIMEOUT_MS=30000
FIREWORKS_EVALUATION_MAX_OUTPUT_TOKENS=4096

# Firebase Admin uses Application Default Credentials / deployment identity.
# Explicit deployment choice: QA = fitdesi-ai; Production = fitdesi-ai-production.
# Never add a service-account JSON credential to this repository.
FIREBASE_PROJECT_ID=
# Current reviewed privacy-notice identifiers. Grants must echo these values.
# Keep empty until notice copy and deployment configuration are manager-approved.
REMOTE_AI_NOTICE_VERSION=
EXPERIMENTAL_AI_NOTICE_VERSION=

# RevenueCat REST API v2 commercial-authority configuration. The v2 secret key
# must have only customer_information:customers:read permission. Entitlement IDs
# are the non-secret internal entl_ values from the RevenueCat dashboard, not
# Android lookup keys or tier names. Keep all values server-side.
REVENUECAT_V2_SECRET_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_PLUS_ENTITLEMENT_ID=
REVENUECAT_PRO_ENTITLEMENT_ID=
REVENUECAT_BOOST_ENTITLEMENT_ID=
REVENUECAT_TIMEOUT_MS=5000

# Fixed server-side Fireworks controls. Android cannot override these values.
FIREWORKS_TIMEOUT_MS=8000
FIREWORKS_MAX_OUTPUT_TOKENS=1800
FIREWORKS_IP_REQUESTS_PER_MINUTE=20
FIREWORKS_INSTALLATION_REQUESTS_PER_MINUTE=12
FIREWORKS_INSTALLATION_REQUESTS_PER_DAY=100
FIREWORKS_MAX_CONCURRENT_REQUESTS=4
FIREWORKS_MAX_CONCURRENT_PER_INSTALLATION=1
FIREWORKS_CIRCUIT_FAILURE_THRESHOLD=3
FIREWORKS_CIRCUIT_RESET_MS=30000

# Comma-separated exact browser origins. Empty denies all browser Origin headers.
# Native Android HTTP clients do not require CORS.
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=false

# Bounded request processing.
REQUEST_BODY_LIMIT_BYTES=32768
REQUEST_TIMEOUT_MS=10000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000

# In-memory per-client demo limiter. Replace with a shared store before scaling.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
